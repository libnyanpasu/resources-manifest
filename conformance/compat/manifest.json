[
  {
    "name": "compat.version.newer_minor",
    "input": {
      "manifest_version": "2.7",
      "registries": {
        "github-release": {
          "name": "GitHub Releases",
          "url_template": "https://github.com/{owner}/{repo}/releases/download/{release}/{artifact}"
        }
      },
      "mirrors": {},
      "resources": {
        "sample": {
          "name": "Sample",
          "registry": "github-release",
          "source": {
            "owner": "example",
            "repo": "project"
          },
          "tags": [
            {
              "id": "channel:stable",
              "name": "Stable",
              "group": "channel"
            }
          ],
          "default_variants": {
            "windows-x86_64": "stable",
            "linux-amd64": "stable"
          },
          "variants": [
            {
              "id": "stable",
              "tag_key": "channel:stable",
              "name": "Stable",
              "tags": [
                {
                  "id": "channel:stable",
                  "name": "Stable",
                  "group": "channel"
                }
              ],
              "source": {
                "release": "{version}"
              },
              "artifacts": {
                "windows-x86_64": {
                  "artifact": "selected-{version}.zip",
                  "version": {
                    "type": "static",
                    "latest": "v1.2.3",
                    "releases": [
                      {
                        "version": "v1.2.3",
                        "checksum": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                      }
                    ]
                  }
                },
                "linux-amd64": {
                  "artifact": "selected-{version}.gz",
                  "version": {
                    "type": "static",
                    "latest": "v1.2.3",
                    "releases": [
                      {
                        "version": "v1.2.3",
                        "checksum": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "expect": {
      "ok": {
        "newer_minor": true,
        "default_variants": {
          "windows-x86_64": "stable",
          "linux-amd64": "stable"
        },
        "artifacts": {
          "windows-x86_64": {
            "ok": true,
            "kind": "authoritative"
          },
          "linux-amd64": {
            "ok": true,
            "kind": "authoritative"
          }
        }
      }
    }
  },
