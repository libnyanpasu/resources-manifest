[
  {
    "name": "kind.finish.gnu",
    "input": {
      "operation": "finish_checksum",
      "manifest": {
        "manifest_version": "2.0",
        "registries": {
          "main": {
            "name": "Main",
            "url_template": "https://origin.test/{artifact}"
          },
          "meta": {
            "name": "Metadata",
            "url_template": "https://meta.test/{artifact}"
          }
        },
        "mirrors": {},
        "resources": {
          "sample": {
            "name": "Sample",
            "registry": "main",
            "tags": [],
            "default_variants": {
              "linux-amd64": "stable"
            },
            "variants": [
              {
                "id": "stable",
                "name": "Stable",
                "tag_key": "",
                "tags": [],
                "artifacts": {
                  "linux-amd64": {
                    "artifact": "pkg-{version}.zip",
                    "version": {
                      "type": "remote",
                      "fallback": {
                        "version": "v1",
                        "checksum": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                        "source": {
                          "release": "fallback-{version}"
                        }
                      },
                      "latest": {
                        "resource": {
                          "registry": "meta",
                          "artifact": "version.txt"
                        },
                        "parser": {
                          "type": "text",
                          "trim": true
                        }
                      },
                      "checksum": {
                        "resource": {
                          "registry": "meta",
                          "artifact": "checksums.txt"
                        },
                        "parser": {
                          "type": "gnu",
                          "algorithm": "sha256"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "resource": "sample",
      "platform": "linux-amd64",
      "version": "v1",
      "response": {
        "body": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  pkg-v1.zip\n",
        "headers": []
      }
    },
    "expect": {
      "ok": {
        "checksum": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "kind": "parsed"
      }
    }
  },
