      "parser": {
        "type": "gnu",
        "algorithm": "sha256"
      },
      "response": {
        "body": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789  prefix-selected.zip\r\n0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF *selected.zip\r\n",
        "headers": []
      },
      "artifact": "selected.zip"
    },
    "expect": {
      "ok": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    }
  },
