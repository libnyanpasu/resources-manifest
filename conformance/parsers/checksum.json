[
  {
    "name": "checksum.checksum.normalized",
    "input": {
      "parser": {
        "type": "checksum"
      },
      "response": {
        "body": " \tSHA256:0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF\r\n",
        "headers": []
      },
      "artifact": "selected.zip"
    },
    "expect": {
      "ok": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    }
  },
  {
    "name": "checksum.gnu.exact_name",
