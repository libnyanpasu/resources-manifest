{
  "$id": "https://libnyanpasu.github.io/resources-manifest/schema/2.0/manifest-template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceManifestTemplate",
  "description": "The authored resource manifest template, input of the compiler.",
  "type": "object",
  "properties": {
    "manifest_version": {
      "$ref": "#/$defs/ManifestVersion"
    },
    "registries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RegistryDefinition"
      }
    },
    "mirrors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MirrorDefinition"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResourceTemplate"
      }
    }
  },
  "additionalProperties": false,
  "required": ["manifest_version", "registries", "resources"],
  "$defs": {
    "ManifestVersion": {
      "type": "string",
      "pattern": "^2\\.(0|[1-9][0-9]*)$"
    },
    "RegistryDefinition": {
      "description": "A registry produces canonical download/metadata URLs.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url_template": {
          "description": "Template for a canonical URL. Artifact registries normally use\n`{artifact}`; metadata registries may instead expose a release page/API.",
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["name", "url_template"]
    },
    "MirrorDefinition": {
      "description": "A mirror transforms a canonical URL into an accelerated/alternative URL.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url_template": {
          "description": "Template for an accelerated/alternative URL. It may use source variables\nand URL components such as `{url}`, `{url_encoded}`, `{host}`, `{path}`\nand `{path_and_query}`.",
          "type": "string"
        },
        "registries": {
          "description": "Limit this mirror to specific registry IDs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "description": "Lower values are preferred when a caller builds an automatic strategy.\nAny finite number is accepted.",
          "type": "number"
        }
      },
      "required": ["name", "url_template"]
    },
    "ResourceTemplate": {
      "description": "A resource as authored in the template.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "source": {
          "description": "Resource-wide variables, normally owner/repository identity.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tags": {
          "description": "Catalog used by variants. Compiled variants contain expanded tag data.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResourceTagDefinition"
          }
        },
        "default_variants": {
          "description": "Platform-specific defaults. A default is inferred when a platform has\nonly one compatible variant; otherwise an explicit value is required.",
          "type": "object",
          "properties": {
            "darwin-arm64": {
              "type": "string"
            },
            "darwin-x64": {
              "type": "string"
            },
            "linux-aarch64": {
              "type": "string"
            },
            "linux-amd64": {
              "type": "string"
            },
            "windows-arm64": {
              "type": "string"
            },
            "windows-x86_64": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "releases": {
          "description": "Release source ID → where the releases come from.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TemplateReleaseSource"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceVariantTemplate"
          }
        }
      },
      "additionalProperties": false,
      "required": ["name", "registry", "tags", "releases", "variants"]
    },
    "ResourceTagDefinition": {
      "description": "A tag without its identifier, used by the per-resource tag catalog.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["name"]
    },
    "TemplateReleaseSource": {
      "description": "Where a resource's releases come from; the generator reads them from the\nGitHub repository named by the resource's `source.owner` and `source.repo`.",
      "oneOf": [
        {
          "description": "The newest `limit` non-draft, non-prerelease releases.",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "type": {
              "type": "string",
              "const": "history"
            }
          },
          "additionalProperties": false,
          "required": ["type", "limit"]
        },
        {
          "description": "One release by tag, usually a mutable prerelease.",
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tag"
            }
          },
          "additionalProperties": false,
          "required": ["type", "tag"]
        }
      ]
    },
    "ResourceVariantTemplate": {
      "description": "A variant as authored in the template.",
      "type": "object",
      "properties": {
        "id": {
          "description": "A stable, human-readable alias. The semantic identity is still the exact\nset of tags, exposed as `tag_key` in the compiled manifest.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "Channel/release variables belong here when channels share one resource.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "darwin-arm64": {
              "$ref": "#/$defs/TemplateArtifact"
            },
            "darwin-x64": {
              "$ref": "#/$defs/TemplateArtifact"
            },
            "linux-aarch64": {
              "$ref": "#/$defs/TemplateArtifact"
            },
            "linux-amd64": {
              "$ref": "#/$defs/TemplateArtifact"
            },
            "windows-arm64": {
              "$ref": "#/$defs/TemplateArtifact"
            },
            "windows-x86_64": {
              "$ref": "#/$defs/TemplateArtifact"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": ["name", "tags", "artifacts"]
    },
    "TemplateArtifact": {
      "description": "A platform artifact as authored in the template.",
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "source": {
          "description": "Artifact-level URL variables.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "version": {
          "$ref": "#/$defs/TemplateArtifactVersion"
        }
      },
      "additionalProperties": false,
      "required": ["artifact", "version"]
    },
    "TemplateArtifactVersion": {
      "description": "How an authored artifact is versioned. Static history and remote fallbacks\ncome from the release snapshot at compile time.",
      "oneOf": [
        {
          "description": "Bounded history from a `history` release source.",
          "type": "object",
          "properties": {
            "releases": {
              "description": "Release source ID.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "static"
            }
          },
          "additionalProperties": false,
          "required": ["type", "releases"]
        },
        {
          "description": "Remote resolution; the fallback comes from a `tag` release source.",
          "type": "object",
          "properties": {
            "releases": {
              "description": "Release source ID.",
              "type": "string"
            },
            "latest": {
              "description": "How the latest version is requested and parsed.",
              "$ref": "#/$defs/RemoteVersionTemplate"
            },
            "checksum": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RemoteChecksumResourceTemplate"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "remote"
            }
          },
          "additionalProperties": false,
          "required": ["type", "releases", "latest"]
        }
      ]
    },
    "RemoteVersionTemplate": {
      "description": "How a remote artifact's version is requested and parsed.\n\nDecoding picks the composite form when the object has a `format` key and\nthe single-response form otherwise (design §9.2).",
      "anyOf": [
        {
          "description": "One response parsed by one version parser.",
          "$ref": "#/$defs/RemoteVersionResourceTemplate"
        },
        {
          "description": "Several responses, each parsed by its own part, combined by `format`.",
          "type": "object",
          "properties": {
            "parts": {
              "description": "Part name → request and parser.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/RemoteVersionResourceTemplate"
              }
            },
            "format": {
              "description": "Authored template that references every part by name.",
              "type": "string"
            }
          },
          "required": ["parts", "format"]
        }
      ]
    },
    "RemoteVersionResourceTemplate": {
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/RemoteResourceTemplate"
        },
        "parser": {
          "$ref": "#/$defs/RemoteVersionParser"
        }
      },
      "required": ["resource", "parser"]
    },
    "RemoteResourceTemplate": {
      "description": "A remote metadata request described declaratively.",
      "type": "object",
      "properties": {
        "registry": {
          "description": "Named registry used to create the canonical metadata URL.",
          "type": "string"
        },
        "artifact": {
          "description": "Optional virtual artifact/path consumed by the registry template.",
          "type": "string"
        },
        "source": {
          "description": "Variables merged on top of resource/variant/artifact source variables.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["registry"]
    },
    "RemoteVersionParser": {
      "description": "How to parse a remote version response.",
      "oneOf": [
        {
          "description": "Use the response body, optionally trimming whitespace.",
          "type": "object",
          "properties": {
            "trim": {
              "description": "Defaults to true.",
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": ["type"]
        },
        {
          "description": "Apply a regular expression and return a capture group.",
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string"
            },
            "group": {
              "description": "Capture group containing the version. Defaults to 1. Deserializing\nnegative or fractional values fails, matching the reference\nvalidator's non-negative integer rule.",
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "type": {
              "type": "string",
              "const": "regex"
            }
          },
          "required": ["type", "pattern"]
        }
      ]
    },
    "RemoteChecksumResourceTemplate": {
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/RemoteResourceTemplate"
        },
        "parser": {
          "$ref": "#/$defs/RemoteChecksumParser"
        }
      },
      "required": ["resource", "parser"]
    },
    "RemoteChecksumParser": {
      "description": "How to parse a remote checksum response.",
      "oneOf": [
        {
          "description": "The response body itself is `<algorithm>:<hex>`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "checksum"
            }
          },
          "required": ["type"]
        },
        {
          "description": "GNU checksum list: `<hex>  <artifact>`.",
          "type": "object",
          "properties": {
            "algorithm": {
              "$ref": "#/$defs/ChecksumAlgorithm"
            },
            "type": {
              "type": "string",
              "const": "gnu"
            }
          },
          "required": ["type", "algorithm"]
        },
        {
          "description": "BSD checksum list: `SHA512 (<artifact>) = <hex>`.",
          "type": "object",
          "properties": {
            "algorithm": {
              "$ref": "#/$defs/ChecksumAlgorithm"
            },
            "type": {
              "type": "string",
              "const": "bsd"
            }
          },
          "required": ["type", "algorithm"]
        },
        {
          "description": "GitHub `/releases/expanded_assets/<tag>` HTML with asset digests.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "github-release-assets"
            }
          },
          "required": ["type"]
        },
        {
          "description": "The digest is read from the named response header (case-insensitive).",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "algorithm": {
              "$ref": "#/$defs/ChecksumAlgorithm"
            },
            "encoding": {
              "$ref": "#/$defs/HeaderEncoding"
            },
            "type": {
              "type": "string",
              "const": "header"
            }
          },
          "required": ["type", "name", "algorithm", "encoding"]
        }
      ]
    },
    "ChecksumAlgorithm": {
      "description": "Supported checksum algorithms.",
      "type": "string",
      "enum": ["md5", "sha256", "sha512"]
    },
    "HeaderEncoding": {
      "description": "How a `header` checksum parser decodes the header value.",
      "oneOf": [
        {
          "description": "Hexadecimal digest, any case.",
          "type": "string",
          "const": "hex"
        },
        {
          "description": "Standard base64 (`+/`, padded) of the raw digest bytes.",
          "type": "string",
          "const": "base64"
        }
      ]
    }
  }
}
